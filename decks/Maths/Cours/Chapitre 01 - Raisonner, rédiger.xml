<deck name="Chapitre 1 - Raisonner, rédiger" tags='Maths::Chapitres'><fields><rich-text name='Front' sides='11'></rich-text><tex name='TeX' sides='11'></tex><rich-text name='Back' sides='01'></rich-text><tex name='Formula' sides='01'></tex></fields><cards><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a^0=1</tex><rich-text name='Front'><p>Puissance zéro</p></rich-text><tex name='TeX'>a\in\mathbb{R},\quad a^0=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>(ab)^n=a^n b^n</tex><rich-text name='Front'><p>Puissance d'un produit</p></rich-text><tex name='TeX'>a,b\in\mathbb{R},\ n\in\mathbb{N},\quad (ab)^n=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|x|\ge0,\ |x|\le M \Harr -M\le x\le M</tex><rich-text name='Front'>Valeur absolue — encadrement</rich-text><tex name='TeX'>(x,y) \in \mathbb{R}^2</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a \leq b \text{ et a et b non nuls et de même signe}</tex><rich-text name='Front'></rich-text><tex name='TeX'>(a,b) \in \mathbb{R}^2 \\ 
\frac{1}{b} \leq \frac{1}{a} \impliedby ?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a+b \leq c+d</tex><rich-text name='Front'></rich-text><tex name='TeX'>(a,b,c,d) \in \mathbb{R}  \\   a\leq b \text{ et } c\leq d \implies ? </tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>t^2 = x \text{ (unique solution positive t)}</tex><rich-text name='Front'></rich-text><tex name='TeX'>x\ge0\\ définir \sqrt{x}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\mathbb{N}={0,1,2,\dots}\\  \mathbb{Z}={\dots,-1,0,1,\dots},\\ \mathbb{Q}=\{p/q\mid p\in\mathbb{Z},q\in\mathbb{N}^*\}</tex><rich-text name='Front'>Ensembles usuels</rich-text><tex name='TeX'>Donner N, Z, Q</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\ln(xy)=\ln x+\ln y</tex><rich-text name='Front'>Logarithme — morphisme</rich-text><tex name='TeX'>x,y\in\mathbb{R}_+^*</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|xy|=|x||y|</tex><rich-text name='Front'><p>Valeur absolue — multiplicativité</p></rich-text><tex name='TeX'>x,y\in\mathbb{R}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|x|=0\iff x=0</tex><rich-text name='Front'><p>Valeur absolue — annulation</p></rich-text><tex name='TeX'>x\in\mathbb{R}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\sqrt{xy}=\sqrt{x}\sqrt{y}</tex><rich-text name='Front'><p>Racine carrée — multiplicativité</p></rich-text><tex name='TeX'>x,y\ge0</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\sqrt{x^2}=|x|</tex><rich-text name='Front'><p>Racine carrée d'un carré</p></rich-text><tex name='TeX'>x\in\mathbb{R}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\mathbb{P}\subset\mathbb{N}\subset\mathbb{Z}\subset\mathbb{Q}\subset\mathbb{R}\subset \Complex</tex><rich-text name='Front'><p>Chaîne d'inclusions des ensembles</p></rich-text><tex name='TeX'></tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a^{n+p}=a^n a^p</tex><rich-text name='Front'><p>Produit de puissances de même base</p></rich-text><tex name='TeX'>a\in\mathbb{R},\ n,p\in\mathbb{N},\quad a^{n+p}=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>(a^n)^p=a^{np}</tex><rich-text name='Front'><p>Puissance d'une puissance</p></rich-text><tex name='TeX'>a\in\mathbb{R},\ n,p\in\mathbb{N},\quad (a^n)^p=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg(P\vee Q)\iff\neg P\wedge\neg Q</tex><rich-text name='Front'><p>Loi de Morgan — négation du OU</p></rich-text><tex name='TeX'>P,Q\text{ assertions},\quad\neg(P\vee Q)\iff?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg(P\wedge Q)\iff\neg P\vee\neg Q</tex><rich-text name='Front'><p>Loi de Morgan — négation du ET</p></rich-text><tex name='TeX'>P,Q\text{ assertions},\quad\neg(P\wedge Q)\iff?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>(P\Rightarrow Q)\iff(\neg Q\Rightarrow \neg P)</tex><rich-text name='Front'><p>Contraposée équivalence</p></rich-text><tex name='TeX'></tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|x+y|\leq |x|+|y|</tex><rich-text name='Front'>Inégalité triangulaire</rich-text><tex name='TeX'>x,y\in\mathbb{R}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a^{-n}=\dfrac{1}{a^n}</tex><rich-text name='Front'><p>Puissances négatives — définition</p></rich-text><tex name='TeX'>a\in\mathbb{R}^*,\ n\in\mathbb{N},\quad a^{-n}=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\left(\frac{x}{y}\right)^n=\frac{x^n}{y^n}</tex><rich-text name='Front'><p>Puissance d'un quotient</p></rich-text><tex name='TeX'>x,y\in\mathbb{R},\ y\neq0,\ n\in\mathbb{N}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\frac{x^m}{x^n}=x^{m-n}</tex><rich-text name='Front'><p>Quotient de puissances de même base</p></rich-text><tex name='TeX'>x\in\mathbb{R}^*,\ m,n\in\mathbb{Z}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\lambda a\leq\lambda b</tex><rich-text name='Front'></rich-text><tex name='TeX'>(a,b,\lambda)\in\mathbb{R}^3,\ a\leq b,\ \lambda\geq0\implies?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\lambda a\geq\lambda b</tex><rich-text name='Front'></rich-text><tex name='TeX'>(a,b,\lambda)\in\mathbb{R}^3,\ a\leq b,\ \lambda\leq0\implies?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>a\leq b</tex><rich-text name='Front'></rich-text><tex name='TeX'>(a,b) \in \mathbb{R}^2  \\   a<b \implies ? </tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>CS : P \implies Q \\ CN : P \impliedby Q \\ CNS : P \iff Q </tex><rich-text name='Front'>Condition nécessaire / suffisante</rich-text><tex name='TeX'></tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|x|=\max(x,-x)=\begin{cases}x \text{ si } x\ge0\\ -x \text{ si } x\le0\end{cases}</tex><rich-text name='Front'></rich-text><tex name='TeX'>x\in\mathbb{R}\\ définir |x|</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\exp(x+y)=\exp(x)\exp(y)</tex><rich-text name='Front'>Exponentielle — morphisme</rich-text><tex name='TeX'>x,y\in\mathbb{R}</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg(\forall x\in E,P(x))\iff\exists x\in E:\neg P(x)</tex><rich-text name='Front'><p>Négation du quantificateur universel</p></rich-text><tex name='TeX'>\neg(\forall x\in E,P(x))\iff?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg(\exists x\in E:P(x))\iff\forall x\in E,\neg P(x)</tex><rich-text name='Front'><p>Négation du quantificateur existentiel</p></rich-text><tex name='TeX'>\neg(\exists x\in E:P(x))\iff?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg(P\Rightarrow Q)\iff P\wedge\neg Q</tex><rich-text name='Front'></rich-text><tex name='TeX'>Exprimer \neg(P\Rightarrow Q)</tex></card><card importance='std'><rich-text name='Back'></rich-text><tex name='Formula'>Q\Rightarrow P</tex><rich-text name='Front'><p>Réciproque de P⟹Q</p></rich-text><tex name='TeX'>P\Rightarrow Q,\quad\text{réciproque}=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\neg Q\Rightarrow\neg P</tex><rich-text name='Front'><p>Contraposée de P⟹Q (définition)</p></rich-text><tex name='TeX'>P\Rightarrow Q,\quad\text{contraposée}=?</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>|\sum_{i=1}^n x_i|\le\sum_{i=1}^n |x_i|</tex><rich-text name='Front'><p>Inégalités triangulaire — somme généralisée</p></rich-text><tex name='TeX'>Pour x_1,...,x_n réels</tex></card><card importance='extra'><rich-text name='Back'></rich-text><tex name='Formula'>\ln(x^{\alpha})=\alpha\ln x</tex><rich-text name='Front'></rich-text><tex name='TeX'>\alpha\in\mathbb{R} \ ln(x^\alpha) = ?</tex></card></cards></deck>
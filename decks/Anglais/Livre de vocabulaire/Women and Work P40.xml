<deck name="Women and Work P40" tags='Voc anglais::Livre de voc'><fields><rich-text name='Front' sides='11'></rich-text><tts name='Back' sides='01' lang='en-US'></tts></fields><cards><card><tts name='Back'><p>To pour into / to flood the job market</p></tts><rich-text name='Front'>envahir le marché du travail</rich-text></card><card><tts name='Back'>to combine / to balance / to juggle work and family</tts><rich-text name='Front'>concilier travail et vie de famille</rich-text></card><card><tts name='Back'>to find a job</tts><rich-text name='Front'>trouver un emploi</rich-text></card><card><tts name='Back'>to be up to the job / equal to the job</tts><rich-text name='Front'><p>être à la hauteur, faire l'affaire</p></rich-text></card><card><tts name='Back'><p>to take up a career</p></tts><rich-text name='Front'><p>Embrasser une carrière</p></rich-text></card><card><tts name='Back'><p>A working woman / working mother</p></tts><rich-text name='Front'><p>femme / mère qui travaille</p></rich-text></card><card><tts name='Back'>to be a breadwinner</tts><rich-text name='Front'>être soutien de famille</rich-text></card><card><tts name='Back'>to have a paid job</tts><rich-text name='Front'>avoir un emploi rémunéré</rich-text></card><card><tts name='Back'><p>to work child friendly hours</p></tts><rich-text name='Front'>avoir des horaires compatibles avec ceux des enfants</rich-text></card><card><tts name='Back'>to be dependent on one’s husband</tts><rich-text name='Front'>dépendre de son mari</rich-text></card><card><tts name='Back'>a nanny</tts><rich-text name='Front'>une nourrice</rich-text></card><card><tts name='Back'><p>to be economically independent (of)</p></tts><rich-text name='Front'>être économiquement indépendante</rich-text></card><card><tts name='Back'>to be underpaid</tts><rich-text name='Front'>être sous-payée</rich-text></card><card><tts name='Back'>a career woman</tts><rich-text name='Front'>une carriériste</rich-text></card><card><tts name='Back'>a part-timer</tts><rich-text name='Front'>un travailleur à temps partiel</rich-text></card><card><tts name='Back'>to achieve financial independence</tts><rich-text name='Front'><p>Gagner l’indépendance financière</p></rich-text></card><card><tts name='Back'>self-fulfilment / self-realization</tts><rich-text name='Front'>l’épanouissement personnel</rich-text></card><card><tts name='Back'>female employment</tts><rich-text name='Front'>l’emploi féminin</rich-text></card><card><tts name='Back'>to multitask</tts><rich-text name='Front'>être capable de mener plusieurs tâches de front</rich-text></card><card><tts name='Back'>to be economically active</tts><rich-text name='Front'>avoir une activité professionnelle</rich-text></card><card><tts name='Back'>a menial job / a lower-status job</tts><rich-text name='Front'>un emploi subalterne</rich-text></card><card><tts name='Back'><p>a creche / (US) a day care center</p></tts><rich-text name='Front'>une crèche / (US) une garderie</rich-text></card><card><tts name='Back'>to take time off after a birth</tts><rich-text name='Front'>prendre un congé après une naissance</rich-text></card><card><tts name='Back'>to hold a top job</tts><rich-text name='Front'>occuper un poste à responsabilité</rich-text></card><card><tts name='Back'>flexitime / (US) flextime</tts><rich-text name='Front'>l’aménagement du temps de travail</rich-text></card><card><tts name='Back'>to earn one’s own money</tts><rich-text name='Front'>gagner son propre argent</rich-text></card><card><tts name='Back'><p>to have school age children</p></tts><rich-text name='Front'>avoir des enfants en âge scolaire</rich-text></card><card><tts name='Back'>a nursery</tts><rich-text name='Front'>une garderie</rich-text></card><card><tts name='Back'>to require stamina</tts><rich-text name='Front'>nécessiter de la résistance</rich-text></card><card><tts name='Back'>a dual-income couple</tts><rich-text name='Front'>un couple bi-actif</rich-text></card><card><tts name='Back'>to make it to the top</tts><rich-text name='Front'>arriver au sommet, réussir</rich-text></card><card><tts name='Back'>to work full time / part time</tts><rich-text name='Front'>travailler à plein temps / à mi-temps</rich-text></card><card><tts name='Back'>to be always on the run</tts><rich-text name='Front'>courir perpétuellement</rich-text></card><card><tts name='Back'>modern woman</tts><rich-text name='Front'>la femme moderne</rich-text></card><card><tts name='Back'>maternity leave</tts><rich-text name='Front'>le congé maternité</rich-text></card><card><tts name='Back'><p>a full time job</p></tts><rich-text name='Front'>un emploi à plein temps</rich-text></card><card><tts name='Back'><p>a part time job</p></tts><rich-text name='Front'>un emploi à temps partiel</rich-text></card></cards></deck>
<deck name="Global inequalitiess P16" tags='Voc anglais::Livre de voc'><fields><rich-text name='Front' sides='11'></rich-text><tts name='Back' sides='01' lang='en-US'></tts></fields><cards><card><tts name='Back'>the struggle against inequalities</tts><rich-text name='Front'>la lutte contre les inégalités</rich-text></card><card><tts name='Back'>wide disparities</tts><rich-text name='Front'>de fortes disparités</rich-text></card><card><tts name='Back'>to redistribute wealth</tts><rich-text name='Front'>redistribuer les richesses</rich-text></card><card><tts name='Back'>poverty / wealth</tts><rich-text name='Front'>la pauvreté / la richesse</rich-text></card><card><tts name='Back'>to make different policy choices</tts><rich-text name='Front'>faire des choix de politiques différentes</rich-text></card><card><tts name='Back'>(to reintroduce / reinstate) wealth tax</tts><rich-text name='Front'>(rétablir) l’impôt sur la fortune</rich-text></card><card><tts name='Back'>to raise inheritance taxes</tts><rich-text name='Front'>augmenter les droits de succession</rich-text></card><card><tts name='Back'>to share more equitably</tts><rich-text name='Front'>partager plus équitablement</rich-text></card><card><tts name='Back'>wealth / income inequality</tts><rich-text name='Front'>l’inégalité de richesse / de revenus</rich-text></card><card><tts name='Back'>glaring / gross inequalities</tts><rich-text name='Front'>des inégalités criantes</rich-text></card><card><tts name='Back'>the gap is widening / is narrowing</tts><rich-text name='Front'>le fossé se creuse / se réduit</rich-text></card><card><tts name='Back'>to tackle prejudice and discrimination</tts><rich-text name='Front'>s’attaquer aux préjugés et aux discriminations</rich-text></card><card><tts name='Back'>the gap between rich and poor</tts><rich-text name='Front'>le fossé entre les riches et les pauvres</rich-text></card><card><tts name='Back'>the rich / the poor</tts><rich-text name='Front'>les riches / les pauvres</rich-text></card><card><tts name='Back'>to prioritize universal energy access</tts><rich-text name='Front'>avoir pour priorité l’accès à l’énergie universelle</rich-text></card><card><tts name='Back'>to take concerted action to build fairer societies</tts><rich-text name='Front'>prendre des mesures concertées pour bâtir des sociétés plus justes</rich-text></card><card><tts name='Back'>to bridge the social divide</tts><rich-text name='Front'>réduire la fracture sociale</rich-text></card><card><tts name='Back'>to bridge the digital divide</tts><rich-text name='Front'>réduire la fracture numérique</rich-text></card><card><tts name='Back'>inequality / inequalities</tts><rich-text name='Front'>l’inégalité, les inégalités</rich-text></card><card><tts name='Back'>inequality is on the rise</tts><rich-text name='Front'>les inégalités sont en hausse</rich-text></card><card><tts name='Back'>the haves and the have-nots</tts><rich-text name='Front'>les riches et les pauvres</rich-text></card><card><tts name='Back'>a better distribution of wealth</tts><rich-text name='Front'>une meilleure répartition des richesses</rich-text></card><card><tts name='Back'>to tackle inequalities</tts><rich-text name='Front'>s’attaquer aux inégalités</rich-text></card><card><tts name='Back'>to invest in public services</tts><rich-text name='Front'>investir dans les services publics</rich-text></card><card><tts name='Back'>racial / gender / age inequality</tts><rich-text name='Front'>l’inégalité en fonction de la race / du sexe / de l’âge</rich-text></card><card><tts name='Back'>to refuse two-tier societies</tts><rich-text name='Front'>refuser les sociétés à deux vitesses</rich-text></card><card><tts name='Back'>to tax the super-rich</tts><rich-text name='Front'>taxer les ultra-riches</rich-text></card><card><tts name='Back'>redistributive fiscal policies</tts><rich-text name='Front'>des politiques fiscales redistributives</rich-text></card><card><tts name='Back'>to promote universal access to education<
# Clés VAPID — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:votre@email.com

# UID Firebase de l'administrateur (Firebase Console → Authentication → utilisateurs)
# Seul cet UID peut supprimer des decks via la modération.
ADMIN_UID=

# GitHub — token avec scope "repo" (Settings → Developer settings → PAT)
GITHUB_TOKEN=
GITHUB_REPO=simon-mgnz/Fab-anki
GITHUB_BRANCH=main

# Email admin (SMTP Gmail : créer un mot de passe d'application)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=

# URL du site et manifest
SITE_URL=https://fabanki-classement.web.app
MANIFEST_URL=https://fabanki-classement.web.app/decks/manifest.json

# Secret optionnel pour notifyDeckManually
NOTIFY_SECRET=
